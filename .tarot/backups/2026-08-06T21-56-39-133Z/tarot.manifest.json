  "projectId": "discowarpcore",
  "displayName": "Disco Warp Core",
  "presentation": {
    "code": "DWC",
    "description": "A local household archive and creative control system for media, objects, and strange interfaces."
  },
  "branding": {
    "terminalColor": 95,
    "sigil": "DWC"
  },
  "primaryService": "frontend",
  "portAssignments": {
    "source": "project-canonical-port-policy",
    "status": "canonical",
    "reason": "Disco Warp Core canonical development ports: backend immediately before frontend.",
    "frontend": 7611,
    "backend": 7610
